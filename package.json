{
  "name": "rc-local-server",
  "version": "0.1.0",
  "private": true,
  "description": "Local RPC/asset server + live request dashboard for Restaurant City (game.swf)",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "db:schema:postgres": "node scripts/generate-postgresql-schema.cjs",
    "db:generate": "node scripts/generate-postgresql-schema.cjs && prisma generate --schema prisma/schema.prisma && prisma generate --schema prisma/schema.postgresql.prisma",
    "db:push": "node scripts/generate-postgresql-schema.cjs && prisma db push",
    "db:migrate:postgres": "node scripts/migrate-sqlite-to-postgres.cjs",
    "build": "npm run db:generate && tsc -p tsconfig.json && tsc -p tsconfig.admin.json",
    "assets:social-icons": "node scripts/sync-social-ingredient-icons.cjs",
    "preview:daily-ingredients": "node scripts/render-daily-ingredients-preview.cjs",
    "repair:coin-reward-gifts": "node scripts/remove-coin-reward-gifts.cjs",
    "repair:mail-integrity": "node scripts/remove-coin-reward-gifts.cjs",
    "repair:ingredient-rewards": "node scripts/repair-missing-ingredient-rewards.cjs",
    "repair:unopened-gifts": "node scripts/remove-unopened-gifts.cjs",
    "check": "npm run db:generate && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.admin.json --noEmit",
    "test": "npm run build && node --test test/*.test.cjs",
    "bench:hotfix": "npm run build && node --expose-gc scripts/benchmark-performance-hotfix.cjs",
    "start": "npm run db:push && npm run build && node dist/server.js",
    "start:built": "node dist/server.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/pg": "^8.15.5",
    "prisma": "^7.8.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@ruffle-rs/ruffle": "0.5.0",
    "better-sqlite3": "^12.11.1",
    "pg": "^8.16.3",
    "pg-copy-streams": "^7.0.0",
    "sharp": "^0.34.5"
  }
}
