# Local production configuration for Restaurant City Reborn.
# Copy to .env and fill in. NEVER commit .env or share RC_PIN_PEPPER.
# See deploy/README.md for the nginx/Ubuntu deployment walkthrough.

NODE_ENV=production

# REQUIRED in production. Use the PostgreSQL database migrated by
# `npm run db:migrate:postgres`; keep credentials in the secret manager.
DATABASE_URL=postgresql://restaurant_city:change-me@127.0.0.1:5432/restaurant_city

# Per-process PostgreSQL pool ceiling. Keep the combined total across all server
# processes below the database provider's connection limit.
RC_DB_POOL_MAX=20
# Server-side ceiling for one SQL statement or lock wait. This is distinct from
# Prisma's whole interactive-transaction timeout.
RC_DB_STATEMENT_TIMEOUT_MS=30000
# Save requests wait in the application instead of occupying connections while
# another save owns the same profile/session locks.
RC_PROFILE_SAVE_CONCURRENCY=8

# Bounded in-process authentication cache. Concurrent requests for one token
# share a single SQL lookup; mutations and revocations invalidate the cache.
RC_SESSION_CACHE_TTL_SECONDS=30
RC_SESSION_CACHE_NEGATIVE_TTL_SECONDS=2
RC_SESSION_CACHE_MAX=5000
# Small server-owned economy/reference datasets only. Player state is never
# stored in this cache.
RC_REFERENCE_CACHE_TTL_SECONDS=300

# Public health probes. Readiness queries are coalesced and briefly cached so a
# monitoring burst cannot create a database-query burst.
RC_HEALTH_READY_CACHE_MS=5000
RC_HEALTH_READY_TIMEOUT_MS=5000

# Operational latency alerts (admin overview plus rate-limited slow-RPC logs).
RC_RPC_P95_ALERT_MS=1000
RC_RPC_P99_ALERT_MS=3000

# SQLite development/rollback source only. Leave unset after PostgreSQL cutover.
# RC_DB_PATH=/var/lib/rc-reborn/dev.db

# Listen address/port. Behind nginx, bind 127.0.0.1 and let nginx proxy.
HOST=127.0.0.1
PORT=8090

# Used only by `npm run maintenance`. Retry text may be words or a number of
# seconds; numeric text is also emitted as the HTTP Retry-After header.
RC_MAINTENANCE_MESSAGE="Our chefs are making a few improvements. Please check back shortly."
RC_MAINTENANCE_RETRY_SECONDS="a few minutes"

# REQUIRED when running behind a reverse proxy that replaces X-Forwarded-*.
RC_TRUST_PROXY=true

# Generate once for this installation, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it unchanged after users create PINs.
RC_PIN_PEPPER=

# Username that is promoted to admin when it first registers.
# Remove the variable afterward; the role stays in the database.
RC_ADMIN_USERNAME=

# Keep false in production. true recreates the six legacy NPC profiles 1001-1006.
RC_SEED_STARTER_FRIENDS=false

# Optional: at 12:00 UTC, rotate the three coin-shop ingredients and announce
# them with an @everyone message and generated PNG. Keep this URL secret.
RC_DISCORD_DAILY_INGREDIENTS_WEBHOOK=
RC_DISCORD_ANOMALY_WEBHOOK=
RC_MODERATION_SCAN_INTERVAL_MINUTES=60
RC_MODERATION_SNAPSHOT_RETENTION_DAYS=90
RC_MODERATION_MAX_SNAPSHOTS_PER_PLAYER=250

# Public leaderboard snapshots are held in memory for this many milliseconds.
# Search, pagination, podiums, and personal rank are served from the snapshot.
RC_LEADERBOARD_CACHE_MS=60000

# Performance hotfix defaults. Keep metadata capture and stdout logging off in
# production. Full capture is an explicit, temporary debugging mode; it remains
# bounded by MAX_LOG_ENTRIES and redacts session/authentication material.
RC_RPC_CAPTURE_MODE=metadata
RC_REQUEST_LOG_STDOUT=false
MAX_LOG_ENTRIES=50

# Coalesce each player's RPC activity counters into one periodic database write.
RC_ACTIVITY_FLUSH_INTERVAL_SECONDS=60
# Maximum simultaneous activity persistence transactions.
RC_ACTIVITY_FLUSH_CONCURRENCY=4

# Discord notification accounts are paged and processed through a pool-aware
# worker limit. Failed user DMs are discarded silently after advancing state.
RC_DISCORD_NOTIFICATION_BATCH_SIZE=100
RC_DISCORD_NOTIFICATION_CONCURRENCY=4

# Automatic save evidence uses one full rollback checkpoint per player per
# interval while retaining a compact ProfileSaveFact for every accepted save.
RC_AUTO_SAVE_SNAPSHOT_INTERVAL_MINUTES=60

# Maximum graceful-drain window before open HTTP connections are closed.
RC_SHUTDOWN_TIMEOUT_SECONDS=15
